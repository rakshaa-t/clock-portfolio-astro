+/* ═══ SHOWCASE MOSAIC ═══ */
+.showcase-page{
+  min-height:100vh;padding:40px 24px 80px;background:var(--bg);
+}
+.showcase-page-inner{
+  max-width:1120px;margin:0 auto;
+}
+.showcase-page-title{margin-bottom:4px;}
+.showcase-page-sub{margin-bottom:0;}
+.showcase-filters{
+  margin-top:20px;
+  max-width:none;
+}
+.showcase-mosaic{
+  display:grid;
+  grid-template-columns:repeat(4,1fr);
+  gap:3px;
+  margin-top:24px;
+}
+.showcase-tile{
+  position:relative;display:block;
+  aspect-ratio:4/3;
+  border-radius:var(--radius-md);
+  overflow:hidden;
+  text-decoration:none;color:inherit;
+  box-shadow:var(--shadow-object);
+  background:#f0eee9;
+  border:1px solid rgba(0,0,0,0.06);
+  border-bottom:2px solid rgba(0,0,0,0.1);
+  border-right:1px solid rgba(0,0,0,0.06);
+  border-top:1px solid rgba(255,255,255,0.15);
+  border-left:1px solid rgba(255,255,255,0.1);
+  transition:transform 0.2s cubic-bezier(0.32,0.72,0,1),box-shadow 0.2s cubic-bezier(0.32,0.72,0,1);
+}
+.showcase-tile::after{
+  content:'';position:absolute;inset:0;border-radius:var(--radius-md);
+  background:radial-gradient(ellipse at 30% 25%,rgba(255,255,255,0.18) 0%,transparent 55%);
+  pointer-events:none;z-index:2;
+  transition:opacity 0.2s cubic-bezier(0.32,0.72,0,1);
+}
+.showcase-tile.is-hovered,.showcase-tile:focus-visible{
+  transform:translateY(-2px) scale(1.01);
+  box-shadow:var(--shadow-md);
+}
+.showcase-tile.is-hovered::after,.showcase-tile:focus-visible::after{opacity:0.7;}
+.showcase-tile:active{transform:scale(0.97);}
+.showcase-tile.filter-hidden{display:none!important;}
+.showcase-tile__media{
+  position:absolute;inset:0;
+  transition:transform 0.3s cubic-bezier(0.32,0.72,0,1);
+}
+.showcase-tile.is-hovered .showcase-tile__media,.showcase-tile:focus-visible .showcase-tile__media{
+  transform:translateY(-28px);
+}
+.showcase-tile__media img,.showcase-tile__media video{
+  width:100%;height:100%;object-fit:cover;display:block;
+  pointer-events:none;
+  outline:1px solid rgba(0,0,0,0.08);outline-offset:-1px;
+}
+.showcase-tile__media video::-webkit-media-controls-start-playback-button,
+.showcase-tile__media video::-webkit-media-controls{display:none !important;-webkit-appearance:none;}
+.showcase-tile__color{
+  width:100%;height:100%;
+  display:flex;align-items:center;justify-content:center;
+  padding:16px;text-align:center;
+}
+.showcase-tile__color-label{color:var(--text-primary);}
+.showcase-tile__overlay{
+  position:absolute;bottom:0;left:0;right:0;
+  display:flex;align-items:center;
+  padding:0 12px;height:28px;
+  background:rgba(0,0,0,0.04);
+  transform:translateY(100%);
+  transition:transform 0.3s cubic-bezier(0.32,0.72,0,1);
+  z-index:3;pointer-events:none;
+}
+.showcase-tile.is-hovered .showcase-tile__overlay,.showcase-tile:focus-visible .showcase-tile__overlay{
+  transform:translateY(0);
+}
+.showcase-tile__overlay span{
+  font-family:'Geist',sans-serif;font-size:var(--text-sm);font-weight:500;
+  color:var(--text-primary);letter-spacing:-0.01em;
+  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
+}
+.showcase-detail-inner{max-width:720px;}
+.showcase-detail-title{margin:16px 0 8px;}
+.showcase-detail-lead{color:var(--text-secondary);margin-bottom:24px;}
+.showcase-detail-hero{margin:16px 0 24px;}
+.showcase-detail-hero video,.showcase-detail-hero img{
+  width:100%;height:auto;display:block;border-radius:var(--radius-md);
+  box-shadow:var(--shadow-object);
+}
+.showcase-detail-color{
+  aspect-ratio:16/10;border-radius:var(--radius-md);
+  display:flex;align-items:center;justify-content:center;
+  box-shadow:var(--shadow-object);
+  color:var(--text-primary);
+}
+.showcase-detail-caption{margin-bottom:16px;}
+.showcase-detail-link-wrap{margin-top:8px;}
+.showcase-gallery{display:flex;flex-direction:column;gap:24px;}
+.showcase-gallery-item{margin:0;}
+.showcase-cta{
+  display:inline-block;margin-top:28px;
+  color:var(--accent);text-decoration:none;
+  border-bottom:1px solid rgba(139,126,200,0.35);
+  transition:color 0.15s cubic-bezier(0.32,0.72,0,1);
+}
+.showcase-cta:hover{color:var(--text-primary);}
+@media(max-width:1023px){
+  .showcase-mosaic{grid-template-columns:repeat(3,1fr);}
+}
+@media(max-width:639px){
+  .showcase-mosaic{grid-template-columns:repeat(2,1fr);gap:8px;}
+  .showcase-page{padding:32px 16px 64px;}
+}
+@media(prefers-reduced-motion:reduce){
+  .showcase-tile,.showcase-tile__media,.showcase-tile__overlay{transition:none;}
+  .showcase-tile.is-hovered,.showcase-tile:focus-visible{transform:none;}
+  .showcase-tile.is-hovered .showcase-tile__media,.showcase-tile:focus-visible .showcase-tile__media{transform:none;}
+  .showcase-tile.is-hovered .showcase-tile__overlay,.showcase-tile:focus-visible .showcase-tile__overlay{transform:translateY(0);opacity:1;}
+}
